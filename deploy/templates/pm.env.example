# 安装后复制为 /etc/pm/pm.env，并执行：chmod 600 /etc/pm/pm.env
# 值中有空格或特殊字符时请使用单引号。不要提交填写后的真实文件。

PM_SERVER_ADDRESS=127.0.0.1
PM_SERVER_PORT=8088

PM_DB_HOST=127.0.0.1
PM_DB_PORT=3306
PM_DB_NAME=pm
PM_DB_USERNAME=pm_app
PM_DB_PASSWORD='CHANGE_ME'
# 部署账号负责备份和执行 DDL；测试阶段可暂时与应用账号相同。
PM_MIGRATION_DB_USERNAME=pm_deploy
PM_MIGRATION_DB_PASSWORD='CHANGE_ME'
# 当前数据库基线包含 01-55 的结构和数据变更。
PM_DB_BASELINE_VERSION=55

PM_REDIS_HOST=127.0.0.1
PM_REDIS_PORT=6379
PM_REDIS_DATABASE=0
PM_REDIS_USERNAME=
PM_REDIS_PASSWORD='CHANGE_ME'

# 至少使用 32 字节随机值，例如：openssl rand -base64 48
PM_TOKEN_SECRET='CHANGE_ME'
PM_TOKEN_EXPIRE_MINUTES=30

PM_UPLOAD_PATH=/data/pm/uploads
PM_LOG_FILE=/var/log/pm/backend.log
PM_APP_LOG_LEVEL=info

# 部署脚本参数
PM_KEEP_RELEASES=5
PM_KEEP_BACKUPS=10
PM_HEALTH_URL=http://127.0.0.1:8088/health
