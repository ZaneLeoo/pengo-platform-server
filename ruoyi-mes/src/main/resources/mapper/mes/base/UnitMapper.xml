<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.mes.base.mapper.UnitMapper">

    <resultMap id="UnitResult" type="com.ruoyi.mes.base.domain.Unit">
        <id property="id" column="id"/>
        <result property="unitCode" column="unit_code"/>
        <result property="unitName" column="unit_name"/>
        <result property="status" column="status"/>
        <result property="createBy" column="create_by"/>
        <result property="createTime" column="create_time"/>
        <result property="updateBy" column="update_by"/>
        <result property="updateTime" column="update_time"/>
        <result property="remark" column="remark"/>
    </resultMap>

    <sql id="selectVo">
        select id, unit_code, unit_name, status,
               create_by, create_time, update_by, update_time, remark
        from unit
    </sql>

    <select id="selectUnitList" parameterType="com.ruoyi.mes.base.domain.Unit" resultMap="UnitResult">
        <include refid="selectVo"/>
        <where>
            <if test="unitCode != null and unitCode != ''">and unit_code like concat('%', #{unitCode}, '%')</if>
            <if test="unitName != null and unitName != ''">and unit_name like concat('%', #{unitName}, '%')</if>
            <if test="status != null and status != ''">and status = #{status}</if>
        </where>
        order by unit_code
    </select>

    <select id="selectUnitById" parameterType="Long" resultMap="UnitResult">
        <include refid="selectVo"/> where id = #{id}
    </select>

    <select id="selectUnitByCode" parameterType="String" resultMap="UnitResult">
        <include refid="selectVo"/> where unit_code = #{unitCode}
    </select>

    <insert id="insertUnit" parameterType="com.ruoyi.mes.base.domain.Unit" useGeneratedKeys="true" keyProperty="id">
        insert into unit (unit_code, unit_name, status, create_by, create_time, remark)
        values (#{unitCode}, #{unitName}, #{status}, #{createBy}, sysdate(), #{remark})
    </insert>

    <update id="updateUnit" parameterType="com.ruoyi.mes.base.domain.Unit">
        update unit
        <set>
            <if test="unitCode != null">unit_code = #{unitCode},</if>
            <if test="unitName != null">unit_name = #{unitName},</if>
            <if test="status != null">status = #{status},</if>
            update_by = #{updateBy}, update_time = sysdate(), remark = #{remark}
        </set>
        where id = #{id}
    </update>

    <delete id="deleteUnitByIds" parameterType="Long">
        delete from unit where id in
        <foreach collection="array" item="id" open="(" separator="," close=")">#{id}</foreach>
    </delete>

</mapper>
