<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.mes.base.mapper.UnitGroupDetailMapper">

    <resultMap id="DetailResult" type="com.ruoyi.mes.base.domain.UnitGroupDetail">
        <id property="id" column="id"/>
        <result property="groupId" column="group_id"/>
        <result property="unitCode" column="unit_code"/>
        <result property="unitName" column="unit_name"/>
        <result property="formulaId" column="formula_id"/>
        <result property="sortOrder" column="sort_order"/>
        <result property="createBy" column="create_by"/>
        <result property="createTime" column="create_time"/>
        <result property="updateBy" column="update_by"/>
        <result property="updateTime" column="update_time"/>
        <result property="remark" column="remark"/>
    </resultMap>

    <sql id="selectVo">
        select d.id, d.group_id, d.unit_code,
               coalesce(u.unit_name, d.unit_name) as unit_name,
               d.formula_id, d.sort_order,
               d.create_by, d.create_time, d.update_by, d.update_time, d.remark
        from unit_group_detail d
        left join unit u on u.unit_code = d.unit_code
    </sql>

    <select id="selectByGroupId" resultMap="DetailResult">
        <include refid="selectVo"/>
        where d.group_id = #{groupId}
        order by sort_order, id
    </select>

    <select id="selectByGroupAndUnit" resultMap="DetailResult">
        <include refid="selectVo"/>
        where d.group_id = #{groupId} and d.unit_code = #{unitCode}
    </select>

    <select id="selectDetailList" parameterType="com.ruoyi.mes.base.domain.UnitGroupDetail" resultMap="DetailResult">
        <include refid="selectVo"/>
        <where>
            <if test="groupId != null">and d.group_id = #{groupId}</if>
            <if test="unitCode != null and unitCode != ''">and d.unit_code = #{unitCode}</if>
        </where>
        order by sort_order, id
    </select>

    <select id="selectDetailById" parameterType="Long" resultMap="DetailResult">
        <include refid="selectVo"/> where id = #{id}
    </select>

    <insert id="insertDetail" parameterType="com.ruoyi.mes.base.domain.UnitGroupDetail" useGeneratedKeys="true" keyProperty="id">
        insert into unit_group_detail (group_id, unit_code, unit_name,
            formula_id, sort_order,
            create_by, create_time, remark)
        values (#{groupId}, #{unitCode}, #{unitName},
            #{formulaId}, #{sortOrder},
            #{createBy}, sysdate(), #{remark})
    </insert>

    <update id="updateDetail" parameterType="com.ruoyi.mes.base.domain.UnitGroupDetail">
        update unit_group_detail
        <set>
            <if test="unitCode != null">unit_code = #{unitCode},</if>
            <if test="unitName != null">unit_name = #{unitName},</if>
            <if test="formulaId != null">formula_id = #{formulaId},</if>
            <if test="formulaId == null">formula_id = null,</if>
            <if test="sortOrder != null">sort_order = #{sortOrder},</if>
            update_by = #{updateBy}, update_time = sysdate(), remark = #{remark}
        </set>
        where id = #{id}
    </update>

    <delete id="deleteDetailByIds" parameterType="Long">
        delete from unit_group_detail where id in
        <foreach collection="array" item="id" open="(" separator="," close=")">#{id}</foreach>
    </delete>

    <select id="countByUnitCode" resultType="int">
        select count(1) from unit_group_detail where unit_code = #{unitCode}
    </select>

    <select id="countByFormulaIds" resultType="int">
        select count(1) from unit_group_detail where formula_id in
        <foreach collection="ids" item="id" open="(" separator="," close=")">#{id}</foreach>
    </select>

    <delete id="deleteByGroupId">
        delete from unit_group_detail where group_id = #{groupId}
    </delete>

</mapper>
