<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.mes.base.mapper.UnitGroupMapper">

    <resultMap id="UnitGroupResult" type="com.ruoyi.mes.base.domain.UnitGroup">
        <id property="id" column="id"/>
        <result property="groupCode" column="group_code"/>
        <result property="groupName" column="group_name"/>
        <result property="groupType" column="group_type"/>
        <result property="status" column="status"/>
        <result property="createBy" column="create_by"/>
        <result property="createTime" column="create_time"/>
        <result property="updateBy" column="update_by"/>
        <result property="updateTime" column="update_time"/>
        <result property="remark" column="remark"/>
    </resultMap>

    <sql id="selectVo">
        select id, group_code, group_name, group_type, status,
               create_by, create_time, update_by, update_time, remark
        from unit_group
    </sql>

    <select id="selectUnitGroupList" parameterType="com.ruoyi.mes.base.domain.UnitGroup" resultMap="UnitGroupResult">
        <include refid="selectVo"/>
        <where>
            <if test="groupCode != null and groupCode != ''">and group_code like concat('%', #{groupCode}, '%')</if>
            <if test="groupName != null and groupName != ''">and group_name like concat('%', #{groupName}, '%')</if>
            <if test="groupType != null and groupType != ''">and group_type = #{groupType}</if>
            <if test="status != null and status != ''">and status = #{status}</if>
        </where>
    </select>

    <select id="selectUnitGroupById" parameterType="Long" resultMap="UnitGroupResult">
        <include refid="selectVo"/> where id = #{id}
    </select>

    <select id="selectUnitGroupByCode" parameterType="String" resultMap="UnitGroupResult">
        <include refid="selectVo"/> where group_code = #{groupCode}
    </select>

    <insert id="insertUnitGroup" parameterType="com.ruoyi.mes.base.domain.UnitGroup" useGeneratedKeys="true" keyProperty="id">
        insert into unit_group (group_code, group_name, group_type, status, create_by, create_time, remark)
        values (#{groupCode}, #{groupName}, #{groupType}, #{status}, #{createBy}, sysdate(), #{remark})
    </insert>

    <update id="updateUnitGroup" parameterType="com.ruoyi.mes.base.domain.UnitGroup">
        update unit_group
        <set>
            <if test="groupCode != null">group_code = #{groupCode},</if>
            <if test="groupName != null">group_name = #{groupName},</if>
            <if test="groupType != null">group_type = #{groupType},</if>
            <if test="status != null">status = #{status},</if>
            update_by = #{updateBy}, update_time = sysdate(), remark = #{remark}
        </set>
        where id = #{id}
    </update>

    <delete id="deleteUnitGroupByIds" parameterType="Long">
        delete from unit_group where id in
        <foreach collection="array" item="id" open="(" separator="," close=")">#{id}</foreach>
    </delete>

</mapper>
