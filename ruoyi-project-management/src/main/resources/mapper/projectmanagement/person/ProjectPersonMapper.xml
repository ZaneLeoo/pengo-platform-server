<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.projectmanagement.person.mapper.ProjectPersonMapper">
    <resultMap id="ProjectPersonResult" type="ProjectPerson">
        <id property="personId" column="person_id"/>
        <result property="personCode" column="person_code"/>
        <result property="personName" column="person_name"/>
        <result property="deptId" column="dept_id"/>
        <result property="userId" column="user_id"/>
        <result property="userName" column="user_name"/>
        <result property="userStatus" column="user_status"/>
        <result property="deptName" column="dept_name"/>
        <result property="positionName" column="position_name"/>
        <result property="email" column="email"/>
        <result property="mobile" column="mobile"/>
        <result property="status" column="status"/>
        <result property="createBy" column="create_by"/>
        <result property="createTime" column="create_time"/>
        <result property="updateBy" column="update_by"/>
        <result property="updateTime" column="update_time"/>
        <result property="remark" column="remark"/>
    </resultMap>

    <sql id="selectProjectPersonVo">
        select u.user_id person_id, u.user_name person_code, u.nick_name person_name, u.dept_id, u.user_id,
               u.user_name, u.status as user_status, d.dept_name,
               COALESCE((
                   SELECT GROUP_CONCAT(p.post_name ORDER BY p.post_id SEPARATOR ', ')
                   FROM sys_user_post up
                   INNER JOIN sys_post p ON p.post_id = up.post_id
                   WHERE up.user_id = u.user_id
               ), '') AS position_name,
               u.email, u.phonenumber mobile, u.status, u.create_by, u.create_time,
               u.update_by, u.update_time, u.remark
        from sys_user u
        left join sys_dept d on d.dept_id = u.dept_id
    </sql>

    <select id="selectProjectPersonList" parameterType="ProjectPerson" resultMap="ProjectPersonResult">
        <include refid="selectProjectPersonVo"/>
        <where>
            <if test="personCode != null and personCode != ''">and u.user_name like concat('%', #{personCode}, '%')</if>
            <if test="personName != null and personName != ''">and u.nick_name like concat('%', #{personName}, '%')</if>
            <if test="deptId != null">and (u.dept_id = #{deptId} or u.dept_id in (
                select dept_id from sys_dept where find_in_set(#{deptId}, ancestors)))</if>
            <if test="status != null and status != ''">and u.status = #{status}</if>
            and u.del_flag = '0'
        </where>
        order by u.user_id desc
    </select>

    <select id="selectEnabledPersonOptions" resultMap="ProjectPersonResult">
        <include refid="selectProjectPersonVo"/>
        where u.status = '0' and u.del_flag = '0'
        <if test="keyword != null and keyword != ''">
            and (u.user_name like concat('%', #{keyword}, '%')
                 or u.nick_name like concat('%', #{keyword}, '%')
                 or d.dept_name like concat('%', #{keyword}, '%'))
        </if>
        order by u.nick_name, u.user_id
        limit 100
    </select>

    <select id="selectProjectPersonById" parameterType="Long" resultMap="ProjectPersonResult">
        <include refid="selectProjectPersonVo"/> where u.user_id = #{personId} and u.del_flag = '0'
    </select>

    <select id="selectProjectPersonByCode" parameterType="String" resultMap="ProjectPersonResult">
        <include refid="selectProjectPersonVo"/> where u.user_name = #{personCode} and u.del_flag = '0' limit 1
    </select>

    <select id="selectAvailableUserOptions" resultType="com.ruoyi.projectmanagement.person.domain.ProjectUserOption">
        select u.user_id, u.user_name, u.nick_name, u.status
        from sys_user u
        where u.del_flag = '0'
          and u.status = '0'
          <if test="keyword != null and keyword != ''">
              and (u.user_name like concat('%', #{keyword}, '%')
                   or u.nick_name like concat('%', #{keyword}, '%'))
          </if>
        order by u.user_name, u.user_id
        limit 100
    </select>

    <select id="selectProjectPersonByUserId" parameterType="Long" resultMap="ProjectPersonResult">
        <!-- user_id 有唯一索引；这里不写固定 limit，避免被 PageHelper 分页查询再次追加 LIMIT。 -->
        <include refid="selectProjectPersonVo"/> where u.user_id = #{userId} and u.del_flag = '0'
    </select>

</mapper>
