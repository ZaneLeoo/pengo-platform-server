<?xml version="1.0" encoding="UTF-8"?><!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.projectmanagement.project.mapper.ProjectInfoMapper"><resultMap id="ProjectInfoResult" type="ProjectInfo"><id property="projectId" column="project_id"/><result property="projectCode" column="project_code"/><result property="projectName" column="project_name"/><result property="categoryId" column="category_id"/><result property="categoryName" column="category_name"/><result property="managerId" column="manager_id"/><result property="managerName" column="manager_name"/><result property="managerCode" column="manager_code"/><result property="managerDeptName" column="manager_dept_name"/><result property="startDate" column="start_date"/><result property="endDate" column="end_date"/><result property="actualStartDate" column="actual_start_date"/><result property="actualEndDate" column="actual_end_date"/><result property="pauseReason" column="pause_reason"/><result property="status" column="status"/><result property="progress" column="progress"/><result property="projectGoal" column="project_goal"/><result property="createBy" column="create_by"/><result property="createTime" column="create_time"/><result property="updateBy" column="update_by"/><result property="updateTime" column="update_time"/><result property="remark" column="remark"/></resultMap>
<sql id="selectProjectVo">select p.*,c.category_name,m.person_name manager_name,m.person_code manager_code,d.dept_name manager_dept_name from pm_project p left join pm_project_category c on c.category_id=p.category_id left join pm_person m on m.person_id=p.manager_id left join sys_dept d on d.dept_id=m.dept_id</sql>
<select id="selectProjectInfoList" parameterType="ProjectInfo" resultMap="ProjectInfoResult"><include refid="selectProjectVo"/><where><if test="projectCode!=null and projectCode!=''">and p.project_code like concat('%',#{projectCode},'%')</if><if test="projectName!=null and projectName!=''">and p.project_name like concat('%',#{projectName},'%')</if><if test="categoryId!=null">and p.category_id=#{categoryId}</if><if test="managerId!=null">and p.manager_id=#{managerId}</if><if test="status!=null and status!=''">and p.status=#{status}</if></where>order by p.project_id desc</select>
<select id="selectProjectInfoById" resultMap="ProjectInfoResult"><include refid="selectProjectVo"/> where p.project_id=#{projectId}</select><select id="selectProjectInfoByCode" resultMap="ProjectInfoResult"><include refid="selectProjectVo"/> where p.project_code=#{projectCode} limit 1</select>
<insert id="insertProjectInfo" useGeneratedKeys="true" keyProperty="projectId">insert into pm_project(project_code,project_name,category_id,manager_id,start_date,end_date,status,progress,project_goal,remark,create_by,create_time) values(#{projectCode},#{projectName},#{categoryId},#{managerId},#{startDate},#{endDate},#{status},#{progress},#{projectGoal},#{remark},#{createBy},sysdate())</insert>
<update id="updateProjectInfo">update pm_project set project_code=#{projectCode},project_name=#{projectName},category_id=#{categoryId},manager_id=#{managerId},start_date=#{startDate},end_date=#{endDate},status=#{status},progress=#{progress},project_goal=#{projectGoal},remark=#{remark},update_by=#{updateBy},update_time=sysdate() where project_id=#{projectId}</update>
<update id="updateLifecycle">update pm_project set status=#{status},progress=#{progress},actual_start_date=#{actualStartDate},actual_end_date=#{actualEndDate},pause_reason=#{pauseReason},update_by=#{updateBy},update_time=sysdate() where project_id=#{projectId}</update>
<select id="countIncompleteTasksByProjectId" resultType="int">select count(*) from pm_project_work_item i where i.project_id=#{projectId} and i.item_type='TASK' and not exists (select 1 from pm_project_work_item c where c.parent_id=i.item_id and c.item_type='TASK') and i.status&lt;&gt;'COMPLETED'</select>
<insert id="insertLifecycleLog">insert into pm_project_lifecycle_log(project_id,action,from_status,to_status,reason,operator,operate_time) values(#{projectId},#{action},#{fromStatus},#{toStatus},#{reason},#{operator},sysdate())</insert>
<delete id="deleteProjectInfoByIds">delete from pm_project where project_id in <foreach collection="array" item="id" open="(" separator="," close=")">#{id}</foreach></delete></mapper>
