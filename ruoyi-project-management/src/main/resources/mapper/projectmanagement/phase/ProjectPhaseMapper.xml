<?xml version="1.0" encoding="UTF-8"?><!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd"><mapper namespace="com.ruoyi.projectmanagement.phase.mapper.ProjectPhaseMapper">
<resultMap id="r" type="ProjectPhase"><id property="phaseId" column="phase_id"/><result property="projectId" column="project_id"/><result property="projectName" column="project_name"/><result property="phaseName" column="phase_name"/><result property="phaseCode" column="phase_code"/><result property="ownerId" column="owner_id"/><result property="ownerName" column="owner_name"/><result property="ownerCode" column="owner_code"/><result property="startDate" column="start_date"/><result property="endDate" column="end_date"/><result property="actualStartDate" column="actual_start_date"/><result property="actualEndDate" column="actual_end_date"/><result property="status" column="status"/><result property="sortOrder" column="sort_order"/><result property="taskCount" column="task_count"/><result property="completedTaskCount" column="completed_task_count"/><result property="remark" column="remark"/></resultMap>
<sql id="vo">select ph.*,p.project_name,o.person_name owner_name,o.person_code owner_code,(select count(*) from pm_project_work_item i where i.phase_id=ph.phase_id and i.item_type='TASK') task_count,(select count(*) from pm_project_work_item i where i.phase_id=ph.phase_id and i.item_type='TASK' and i.status='COMPLETED') completed_task_count from pm_project_phase ph join pm_project p on p.project_id=ph.project_id left join pm_person o on o.person_id=ph.owner_id</sql>
<select id="selectList" resultMap="r"><include refid="vo"/><where><if test="projectId!=null">and ph.project_id=#{projectId}</if><if test="status!=null and status!=''">and ph.status=#{status}</if></where>order by ph.sort_order,ph.phase_id</select><select id="selectById" resultMap="r"><include refid="vo"/> where ph.phase_id=#{id}</select>
<insert id="insert" useGeneratedKeys="true" keyProperty="phaseId">insert into pm_project_phase(project_id,phase_code,phase_name,owner_id,start_date,end_date,status,sort_order,remark,create_by,create_time) values(#{projectId},#{phaseCode},#{phaseName},#{ownerId},#{startDate},#{endDate},#{status},#{sortOrder},#{remark},#{createBy},sysdate())</insert>
<update id="update">update pm_project_phase set phase_code=#{phaseCode},phase_name=#{phaseName},owner_id=#{ownerId},start_date=#{startDate},end_date=#{endDate},sort_order=#{sortOrder},remark=#{remark},update_by=#{updateBy},update_time=sysdate() where phase_id=#{phaseId}</update><delete id="deleteById">delete from pm_project_phase where phase_id=#{id}</delete>
<select id="countTasks" resultType="int">select count(*) from pm_project_work_item where phase_id=#{id} and item_type='TASK'</select><select id="countIncompleteLeafTasks" resultType="int">select count(*) from pm_project_work_item i where i.phase_id=#{id} and i.item_type='TASK' and not exists(select 1 from pm_project_work_item c where c.parent_id=i.item_id and c.item_type='TASK') and i.status&lt;&gt;'COMPLETED'</select>
<update id="updateLifecycle">update pm_project_phase set status=#{status},actual_start_date=#{actualStartDate},actual_end_date=#{actualEndDate},update_by=#{updateBy},update_time=sysdate() where phase_id=#{phaseId}</update><insert id="insertLifecycleLog">insert into pm_project_phase_lifecycle_log(phase_id,project_id,action,from_status,to_status,operator,operate_time) values(#{phaseId},#{projectId},#{action},#{fromStatus},#{toStatus},#{operator},sysdate())</insert>
<select id="countIncompleteByProject" resultType="int">select count(*) from pm_project_phase where project_id=#{projectId} and status&lt;&gt;'COMPLETED'</select><select id="countByProject" resultType="int">select count(*) from pm_project_phase where project_id=#{projectId}</select></mapper>
