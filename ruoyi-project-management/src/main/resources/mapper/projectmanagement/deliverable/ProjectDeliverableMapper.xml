<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.projectmanagement.deliverable.mapper.ProjectDeliverableMapper">
  <resultMap id="deliverable" type="ProjectDeliverable"><id property="deliverableId" column="deliverable_id"/><result property="projectId" column="project_id"/><result property="projectName" column="project_name"/><result property="taskId" column="task_id"/><result property="taskName" column="task_name"/><result property="deliverableName" column="deliverable_name"/><result property="deliverableType" column="deliverable_type"/><result property="requiredFlag" column="required_flag"/><result property="approvalRequired" column="approval_required"/><result property="reviewer" column="reviewer"/><result property="status" column="status"/><result property="description" column="description"/><result property="submitBy" column="submit_by"/><result property="latestFileUrl" column="latest_file_url"/><result property="latestExternalUrl" column="latest_external_url"/></resultMap>
  <resultMap id="submission" type="ProjectDeliverableSubmission"><id property="submissionId" column="submission_id"/><result property="deliverableId" column="deliverable_id"/><result property="versionNo" column="version_no"/><result property="fileUrl" column="file_url"/><result property="externalUrl" column="external_url"/><result property="submitBy" column="submit_by"/><result property="submitTime" column="submit_time"/><result property="reviewResult" column="review_result"/><result property="reviewComment" column="review_comment"/><result property="reviewBy" column="review_by"/><result property="reviewTime" column="review_time"/></resultMap>
  <sql id="vo">select d.*,p.project_name,t.item_name task_name from pm_project_deliverable d join pm_project p on p.project_id=d.project_id join pm_project_work_item t on t.item_id=d.task_id</sql>
  <select id="selectList" parameterType="ProjectDeliverable" resultMap="deliverable"><include refid="vo"/><where><if test="projectId!=null">and d.project_id=#{projectId}</if><if test="taskId!=null">and d.task_id=#{taskId}</if><if test="status!=null and status!=''">and d.status=#{status}</if><if test="deliverableName!=null and deliverableName!=''">and d.deliverable_name like concat('%',#{deliverableName},'%')</if></where> order by d.task_id,d.deliverable_id desc</select>
  <select id="selectById" resultMap="deliverable"><include refid="vo"/> where d.deliverable_id=#{deliverableId}</select>
  <insert id="insert" useGeneratedKeys="true" keyProperty="deliverableId">insert into pm_project_deliverable(project_id,task_id,deliverable_name,deliverable_type,required_flag,approval_required,reviewer,status,description,create_by,create_time) values(#{projectId},#{taskId},#{deliverableName},#{deliverableType},#{requiredFlag},#{approvalRequired},#{reviewer},#{status},#{description},#{createBy},sysdate())</insert>
  <update id="update">update pm_project_deliverable set task_id=#{taskId},deliverable_name=#{deliverableName},deliverable_type=#{deliverableType},required_flag=#{requiredFlag},approval_required=#{approvalRequired},description=#{description},update_by=#{updateBy},update_time=sysdate() where deliverable_id=#{deliverableId}</update>
  <update id="updateStatus">update pm_project_deliverable set status=#{status},submit_by=#{submitBy},latest_file_url=#{latestFileUrl},latest_external_url=#{latestExternalUrl},update_time=sysdate() where deliverable_id=#{deliverableId}</update>
  <delete id="deleteByIds">delete from pm_project_deliverable where deliverable_id in <foreach collection="array" item="id" open="(" separator="," close=")">#{id}</foreach></delete>
  <select id="countUnsatisfiedRequiredByTaskId" resultType="int">select count(*) from pm_project_deliverable where task_id=#{taskId} and required_flag='1' and ((approval_required='0' and status!='DELIVERED') or (approval_required='1' and status!='APPROVED'))</select>
  <select id="countByTaskId" resultType="int">select count(*) from pm_project_deliverable where task_id=#{taskId}</select>
  <select id="selectSubmissions" resultMap="submission">select * from pm_project_deliverable_submission where deliverable_id=#{deliverableId} order by version_no desc,submission_id desc</select>
  <select id="selectNextVersion" resultType="int">select coalesce(max(version_no),0)+1 from pm_project_deliverable_submission where deliverable_id=#{deliverableId}</select>
  <insert id="insertSubmission" useGeneratedKeys="true" keyProperty="submissionId">insert into pm_project_deliverable_submission(deliverable_id,version_no,file_url,external_url,submit_by,submit_time,review_result) values(#{deliverableId},#{versionNo},#{fileUrl},#{externalUrl},#{submitBy},sysdate(),#{reviewResult})</insert>
  <update id="updateSubmissionReview">update pm_project_deliverable_submission set review_result=#{reviewResult},review_comment=#{reviewComment},review_by=#{reviewBy},review_time=sysdate() where submission_id=#{submissionId}</update>
</mapper>
